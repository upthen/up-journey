# 后端镜像：uv 安装依赖 → 精简运行时（容器内 Python 3.12）
# REGISTRY：基础镜像来源，默认 docker.io；deploy.sh 会指向 NAS 私有镜像库。
# builder 与 runtime 必须同 WORKDIR（/srv）：venv 脚本 shebang 是绝对路径，
# 两阶段路径不一致会导致 alembic/uvicorn "not found"。
ARG REGISTRY=docker.io
ARG UV_IMAGE=ghcr.io/astral-sh/uv:python3.12-bookworm-slim
FROM --platform=linux/arm64 ${UV_IMAGE} AS builder
WORKDIR /srv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY alembic.ini ./
COPY alembic ./alembic
COPY app ./app
COPY scripts ./scripts
RUN uv sync --frozen --no-dev --no-install-project

FROM --platform=linux/arm64 ${REGISTRY}/library/python:3.12-slim-bookworm
WORKDIR /srv
COPY --from=builder /srv /srv
ENV PATH="/srv/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1
EXPOSE 8000
# 启动即自动迁移（含首次建表 + 城市字典种子），再起 uvicorn
CMD ["sh", "-c", "alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 2"]
