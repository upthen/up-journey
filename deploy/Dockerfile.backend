# 后端镜像：uv 安装依赖 → 精简运行时（容器内 Python 3.12）
FROM --platform=linux/arm64 ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS builder
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY alembic.ini ./
COPY alembic ./alembic
COPY app ./app
COPY scripts ./scripts
RUN uv sync --frozen --no-dev --no-install-project

FROM --platform=linux/arm64 python:3.12-slim-bookworm
WORKDIR /srv
# libheif 运行时依赖由 pillow-heif wheel 自带；再补 mysql 客户端不需要（纯 python 驱动）
COPY --from=builder /app /srv
ENV PATH="/srv/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1
EXPOSE 8000
# 启动即自动迁移（含首次建表 + 城市字典种子），再起 uvicorn
CMD ["sh", "-c", "alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 2"]
